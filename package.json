{
  "name": "COGnito",
  "version": "1.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:performance": "npx playwright test",
    "test:performance:report": "npx playwright test --reporter=html",
    "test:performance:ui": "npx playwright test --ui",
    "test:performance:headed": "npx playwright test --headed",
    "test:auth": "npx playwright test --config=playwright.auth.config.js",
    "test:viewer": "npx playwright test --config=playwright.viewer.config.js",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "setup": "bash scripts/setup-supabase.sh"
  },
  "dependencies": {
    "@conaonda/ol-cog-layers": "^0.3.2",
    "@supabase/supabase-js": "^2.97.0",
    "ol": "^10.8.0",
    "ol-mapbox-style": "^13.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^28.1.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
